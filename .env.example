# =============================================================================
# CRYPTO TRADING BOT — VARIÁVEIS DE AMBIENTE
# =============================================================================
# INSTRUÇÕES:
#   1. Copie este arquivo para .env (nunca versione o .env real)
#   2. Preencha os valores conforme seu ambiente
#   3. NUNCA coloque chaves reais em código ou compartilhe o .env
#   4. Para começar, mantenha TRADING_MODE=paper e ENABLE_LIVE_TRADING=false
# =============================================================================

# --- MODO DE OPERAÇÃO ---
# Valores possíveis: paper | testnet | demo | live
# 'demo' adicionado na FASE 9 Fatia 2 para Bybit Demo Trading
# (https://api-demo.bybit.com), ambiente separado de testnet.
# PADRÃO OBRIGATÓRIO: paper
TRADING_MODE=paper

# Proteção dupla contra execução real acidental.
# Para habilitar live trading, AMBAS as variáveis devem ser configuradas.
# Mesmo assim, o código exige confirmação explícita adicional.
ENABLE_LIVE_TRADING=false

# FASE 5 — Trava DUPLA para execução em testnet.
# Mesmo com TRADING_MODE=testnet, NENHUMA ordem é enviada se esta flag for false.
# Adicional: chamada explícita exige confirm_testnet_execution=True.
ENABLE_TESTNET_EXECUTION=false

# FASE 9 Fatia 2 — Trava DUPLA para execução em Bybit Demo Trading.
# PARALELA a ENABLE_TESTNET_EXECUTION (demo e testnet são ambientes distintos).
# Mesmo com TRADING_MODE=demo, NENHUMA ordem é enviada se esta flag for false.
# Adicional: chamada explícita exige confirm_demo_execution=True.
# ⚠️  NÃO afrouxa ENABLE_LIVE_TRADING. Mainnet/live permanece bloqueado.
#
# FASE 9 Fatia 3 — quando TRADING_MODE=demo + ENABLE_DEMO_EXECUTION=true +
# BYBIT_USE_DEMO=true (ou BYBIT_ENVIRONMENT=demo) + credentials presentes,
# o comando abaixo PODE chamar get_balance() REAL em api-demo.bybit.com
# (read-only). Envio de ordem demo continua bloqueado.
#     python scripts/run_bybit_demo_diagnostic.py --safe-check --confirm-demo-execution
ENABLE_DEMO_EXECUTION=false

# FASE 6 — Executor usado pelo BotEngine: paper | testnet
# PADRÃO SEGURO: paper (PaperTrader, simulação local, sem API).
# 'testnet' integra o BybitTestnetExecutor ao BotEngine, mas AINDA exige o
# triple-lock do testnet (TRADING_MODE=testnet + ENABLE_TESTNET_EXECUTION=true +
# confirm_testnet_execution=True). 'live' é PROIBIDO — execução real de mainnet
# NUNCA é integrada ao BotEngine.
EXECUTOR_TYPE=paper

# FASE 8 — Provider ID consultado pelo ProviderRegistry.
# Valores aceitos:
#   paper                      → ACTIVE (default seguro, PaperTrader)
#   bybit_testnet_linear       → RESTRICTED (operador atual sem acesso ao derivativo)
#   binance_futures_testnet    → DRY_RUN_ONLY (adapter esqueleto, sem integração real)
#   hyrotrader_cleo_demo       → UNCONFIRMED (mecanismo de integração não confirmado)
#   tealstreet_cli_gateway     → DRY_RUN_ONLY (FASE 9B — adapter esqueleto, sem subprocess/HTTP)
# Valores PROIBIDOS (rejeitados no validator):
#   live, mainnet, real, production, prod, bybit_mainnet, binance_mainnet,
#   hyrotrader_real, bybit_live, binance_live
# ⚠️  Mudar PROVIDER_ID NÃO autoriza execução real. O ProviderRegistry +
#     ModeGuard.assert_provider_allowed continuam soberanos.
PROVIDER_ID=paper

# FASE 9B — Tealstreet CLI Gateway (experimental, DRY_RUN_ONLY)
# ⚠️  Adapter NUNCA executa subprocess nem envia HTTP. dry_run=False está BLOQUEADO.
# ⚠️  Uso real com HyroTrader depende dos ToS/regras da prop firm.
# ⚠️  NUNCA embutir token em URL. NUNCA versionar o valor real de TEALSTREET_HOOK_SECRET.
# Placeholders abaixo são SOMENTE referência; ficam comentados e não são carregados.
# TEALSTREET_CLI_PATH=/path/to/tealstreet/cli
# TEALSTREET_ACCOUNT_ID=demo_account_id
# TEALSTREET_HOOK_URL=https://hook.example/your_hook_id
# TEALSTREET_HOOK_ID=your_hook_id_here
# TEALSTREET_HOOK_SECRET=                   # quando presente, deve ser tratado como SecretStr

# --- EXCHANGE: BYBIT ---
# Deixe em branco ou com placeholders enquanto estiver em modo paper.
# Use apenas chaves de TESTNET enquanto estiver em fase de testes.
# Gere em: https://testnet.bybit.com/app/user/api-management
BYBIT_API_KEY=your_testnet_api_key_here
BYBIT_API_SECRET=your_testnet_api_secret_here

# Endpoint da Bybit (LEGADO): testnet=true usa o ambiente de testes.
# ⚠️  FASE 9 — Fatia 1: a precedência caiu para 3º lugar. Os campos abaixo
#     têm prioridade. Mantém-se aqui para retrocompat de fluxo testnet.
BYBIT_USE_TESTNET=true

# FASE 9 — Fatia 1: ambiente Bybit explícito.
# Valores aceitos: testnet | demo (mainnet NÃO é selecionável aqui).
# Quando vazio, deduz de use_demo/use_testnet.
# BYBIT_ENVIRONMENT=demo

# FASE 9 — Fatia 1: atalho de PRECEDÊNCIA MÁXIMA para Bybit Demo Trading.
# true → força environment=demo (endpoint https://api-demo.bybit.com).
# ⚠️  Demo Trading é AMBIENTE SEPARADO de Testnet — não confundir.
# ⚠️  Key/secret devem ser gerados em "Demo Trading" na UI da Bybit
#     (não na seção testnet tradicional).
# BYBIT_USE_DEMO=false

# FASE 5 — Janela de validade da requisição em milissegundos (Bybit V5).
# Recomendação Bybit: 5000ms. Faixa permitida: [100, 60000].
BYBIT_RECV_WINDOW=5000

# --- CAPITAL SIMULADO (Paper Trading) ---
# Saldo inicial simulado para paper trading
PAPER_TRADING_INITIAL_BALANCE=5000.0

# Moeda base para o saldo simulado
PAPER_TRADING_CURRENCY=USDT

# --- PARÂMETROS GERAIS ---
# Símbolo principal para trading
DEFAULT_SYMBOL=BTCUSDT

# Timeframe padrão para candles (ex: 1, 5, 15, 60, 240, D)
DEFAULT_TIMEFRAME=15

# --- CONFIGURAÇÃO DE CONTA ---
# Tamanho da conta em USD. BASE de todos os cálculos de risco.
# Exemplos: 5000 (HyroTrader 5k), 10000 (10k), 25000 (25k)
# NUNCA deixe hardcoded no código. Configure aqui.
RISK_ACCOUNT_SIZE_USD=5000.0

# Nome do perfil (apenas informativo, não altera limites automaticamente)
# Exemplos: hyrotrader_5k | hyrotrader_10k | hyrotrader_25k | custom
RISK_ACCOUNT_PROFILE_NAME=hyrotrader_5k

# --- LIMITES DE RISCO (Preenchidos na FASE 3 com regras HyroTrader) ---
# Estes valores são PORCENTAGENS relativas ao RISK_ACCOUNT_SIZE_USD.
# Configure com as regras reais do seu plano antes de operar.

# Perda máxima diária permitida (% da conta)
RISK_MAX_DAILY_LOSS_PCT=0.05

# Perda máxima total permitida (% da conta)
RISK_MAX_TOTAL_LOSS_PCT=0.10

# Risco máximo por trade (% da conta)
RISK_MAX_RISK_PER_TRADE_PCT=0.01

# Máximo de trades por dia (anti-overtrading)
RISK_MAX_TRADES_PER_DAY=10

# Máximo de posições abertas simultaneamente
RISK_MAX_OPEN_POSITIONS=3

# Exposição máxima por ativo (% da conta)
RISK_MAX_EXPOSURE_PER_ASSET_PCT=0.20

# Tamanho máximo de posição por trade (% da conta)
RISK_MAX_POSITION_SIZE_PCT=0.10

# Alavancagem máxima permitida
RISK_MAX_LEVERAGE=3

# Stop loss mínimo obrigatório por operação (% do preço de entrada)
RISK_MIN_STOP_LOSS_PCT=0.005

# --- LOGS ---
# Nível de log: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Diretório para arquivos de log
LOG_DIR=logs

# Reter logs por N dias (0 = sem rotação)
LOG_RETENTION_DAYS=30

# --- NOTIFICAÇÕES (futuro) ---
# TELEGRAM_BOT_TOKEN=your_token_here
# TELEGRAM_CHAT_ID=your_chat_id_here

# --- IA AUXILIAR (futuro — NÃO decide trades) ---
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-4o

# --- POLYMARKET (futuro) ---
# POLYMARKET_API_KEY=your_polymarket_key_here
